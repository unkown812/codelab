%% Bake to PNG for print builds with Mermaid CLI:
%%   mmdc -i diagrams/data-flow.mmd -o diagrams/data-flow.png
flowchart LR
    Lib["src/lib/seo.ts + posts.ts"] --> Params["generateStaticParams"]
